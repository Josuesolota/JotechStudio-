---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalHero from "../components/TerminalHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CTASection from "../components/CTASection.astro";
import { safeFetch } from "../lib/sanity";
import { FEATURED_PROJECTS_QUERY } from "../lib/queries";
import type { Project } from "../types/project";

const featuredProjects = await safeFetch<Project[]>(FEATURED_PROJECTS_QUERY, {}, []);

const heroLines = [
  { prompt: "$", output: "whoami" },
  { prompt: ">", output: "Dev full-stack · especialista em Fintech & Trading Systems" },
  { prompt: "$", output: "stack --core" },
  { prompt: ">", output: "Python · TypeScript · Deriv API · Automação de estratégias" },
  { prompt: "$", output: "status" },
  { prompt: ">", output: "disponível_para_novos_projetos: true ▮" },
];
---

<BaseLayout
  title="Início"
  description="Desenvolvedor full-stack especializado em plataformas fintech e sistemas de trading algorítmico. Veja projetos e solicite um orçamento."
>
  <section class="hero section">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Freelancer · Dev + Trader Algorítmico</span>
        <h1>Construo sistemas que operam mercados — e sites que operam vendas.</h1>
        <p>
          Desenvolvimento web e automações sob medida, com profundidade real em fintechs,
          corretoras e trading algorítmico. Da ideia ao deploy, sem enrolação.
        </p>
        <div class="hero__actions">
          <a href="/projetos" class="btn btn--primary">Ver projetos</a>
          <a href="/contato" class="btn">Solicitar orçamento</a>
        </div>
      </div>
      <TerminalHero lines={heroLines} />
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="section--tight">
        <div class="container">
          <span class="eyebrow">Trabalhos selecionados</span>
          <h2>Projetos em destaque</h2>
          <div class="projects-grid">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredProjects.length === 0 && (
      <section class="section--tight">
        <div class="container">
          <span class="eyebrow">Trabalhos selecionados</span>
          <h2>Projetos em breve</h2>
          <p>
            Ainda estou publicando os cases pelo painel de administração. Volte em breve ou
            entre em contato para ver exemplos diretamente.
          </p>
        </div>
      </section>
    )
  }

  <CTASection />
</BaseLayout>

<style>
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
