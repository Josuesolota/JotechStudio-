---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import CTASection from "../../components/CTASection.astro";
import { categoriesOf, getAllProjects } from "../../lib/projects";

const projects = await getAllProjects();
const categories = categoriesOf(projects);
const hasConcepts = projects.some((p) => p.kind === "concept");
---

<BaseLayout
  title="Projetos"
  description="Portfólio de sites, lojas online, web apps, automações e sistemas de trading algorítmico desenvolvidos por Josué Solota."
>
  <section class="section">
    <div class="container">
      <header class="page-head" data-reveal>
        <span class="eyebrow">Portfólio</span>
        <h1>Projetos</h1>
        <p class="lead">
          Uma seleção de trabalhos e peças de demonstração. Filtre por área para ver o que
          mais se aproxima do que precisa.
        </p>
      </header>

      {categories.length > 1 && <CategoryFilter categories={categories} />}

      {
        projects.length > 0 ? (
          <div class="projects-grid">
            {projects.map((project, i) => (
              <ProjectCard project={project} eager={i < 2} headingLevel={2} />
            ))}
          </div>
        ) : (
          <p>Nenhum projeto publicado ainda. Volte em breve.</p>
        )
      }

      {
        hasConcepts && (
          <p class="disclaimer mono" data-reveal>
            <strong>Nota:</strong> os cartões marcados como <em>Conceito</em> são peças de
            demonstração criadas para mostrar abordagem técnica e de design — não trabalhos
            de clientes.
          </p>
        )
      }
    </div>
  </section>

  <CTASection
    title="Não encontrou algo parecido com o seu caso?"
    description="Cada projeto é diferente. Conte-me o seu contexto e digo-lhe honestamente se sou a pessoa certa."
  />
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: var(--space-12);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-6);
  }

  .disclaimer {
    margin-top: var(--space-10);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--line-strong);
    font-size: 0.82rem;
    color: var(--paper-faint);
    max-width: 60ch;
  }

  .disclaimer strong {
    color: var(--paper-dim);
  }
</style>
