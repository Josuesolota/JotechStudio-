---
/**
 * Terminal animado do hero. Mantém a referência dupla do perfil
 * (terminal de código / terminal de trading), agora com a paleta
 * da marca. O conteúdo é renderizado no HTML (bom para SEO e para
 * quem tem JS desligado); o JS apenas adiciona o efeito de escrita.
 */
interface Props {
  lines: { prompt: string; output: string }[];
}
const { lines } = Astro.props;
---

<div class="terminal" data-reveal>
  <div class="terminal__glow" aria-hidden="true"></div>
  <div class="terminal__frame">
    <div class="terminal__titlebar">
      <span class="dot dot--red"></span>
      <span class="dot dot--amber"></span>
      <span class="dot dot--green"></span>
      <span class="mono terminal__title">jotech@studio: ~/session.log</span>
    </div>
    <div class="terminal__body mono" id="terminal-body">
      {
        lines.map((line) => (
          <p class="terminal__line" data-prompt={line.prompt} data-output={line.output}>
            <span class="terminal__text">{line.output}</span>
          </p>
        ))
      }
    </div>
  </div>
</div>

<style>
  .terminal {
    position: relative;
    max-width: 620px;
    width: 100%;
  }

  .terminal__glow {
    position: absolute;
    inset: 12% 8%;
    background: radial-gradient(60% 60% at 50% 50%, rgba(47, 111, 224, 0.45), transparent 70%);
    filter: blur(48px);
    z-index: -1;
  }

  .terminal__frame {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(180deg, rgba(12, 20, 36, 0.96), rgba(4, 7, 15, 0.98));
    box-shadow: var(--shadow);
  }

  .terminal__titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    background: rgba(4, 7, 15, 0.6);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot--red {
    background: var(--signal-down);
  }
  .dot--amber {
    background: var(--signal-warn);
  }
  .dot--green {
    background: var(--signal-up);
  }

  .terminal__title {
    margin-left: var(--space-2);
    font-size: 0.72rem;
    color: var(--paper-faint);
  }

  .terminal__body {
    padding: var(--space-6);
    min-height: 230px;
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .terminal__line {
    margin: 0;
    color: var(--paper);
    min-height: 1.5em;
    max-width: none;
  }

  .terminal__line::before {
    content: attr(data-prompt) " ";
    color: var(--brand-green);
    font-weight: 500;
  }

  .terminal__line[data-prompt=">"]::before {
    color: var(--brand-cyan);
  }

  .terminal__line:last-child .terminal__text::after {
    content: "▮";
    color: var(--brand-green);
    animation: blink 1.1s steps(2, start) infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  @media (max-width: 720px) {
    .terminal__body {
      font-size: 0.8rem;
      padding: var(--space-4);
      min-height: 200px;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const lineEls = Array.from(
    document.querySelectorAll<HTMLElement>("#terminal-body .terminal__line")
  );

  async function typeLine(el: HTMLElement) {
    const target = el.querySelector<HTMLElement>(".terminal__text");
    const output = el.dataset.output ?? "";
    if (!target) return;
    for (let i = 0; i <= output.length; i++) {
      target.textContent = output.slice(0, i);
      await new Promise((r) => setTimeout(r, 16));
    }
  }

  async function run() {
    for (const el of lineEls) {
      const t = el.querySelector<HTMLElement>(".terminal__text");
      if (t) t.textContent = "";
    }
    for (const el of lineEls) {
      await typeLine(el);
      await new Promise((r) => setTimeout(r, 200));
    }
  }

  // Só anima quando o terminal entra no ecrã e se o utilizador não pediu
  // redução de movimento — caso contrário o texto já está no HTML.
  if (!prefersReduced && lineEls.length) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) {
          obs.disconnect();
          run();
        }
      },
      { threshold: 0.35 }
    );
    io.observe(lineEls[0].parentElement as Element);
  }
</script>
