---
import Logo from "./Logo.astro";
import { NAV_LINKS } from "../data/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Jotech Studio — página inicial">
      <Logo showTagline />
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label="Navegação principal">
      <ul class="primary-nav__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="primary-nav__link"
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contato" class="btn btn--primary btn--sm primary-nav__cta">Pedir orçamento</a>
    </nav>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Abrir menu de navegação</span>
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>
  <div class="site-header__progress" id="scroll-progress" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(4, 7, 15, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .site-header:global(.is-scrolled) {
    background: rgba(4, 7, 15, 0.94);
    box-shadow: 0 10px 30px -20px rgba(0, 0, 0, 1);
  }

  .site-header__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 0%;
    background: var(--brand-gradient);
    transition: width 0.1s linear;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    padding-block: var(--space-3);
  }

  .site-header__logo {
    text-decoration: none;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .primary-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav__link {
    position: relative;
    color: var(--paper-dim);
    text-decoration: none;
    font-size: 0.94rem;
    padding-block: 0.35rem;
    transition: color 0.18s ease;
  }

  .primary-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
    transition: right 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .primary-nav__link:hover,
  .primary-nav__link[aria-current="page"] {
    color: var(--paper);
  }

  .primary-nav__link:hover::after,
  .primary-nav__link[aria-current="page"]::after {
    right: 0;
  }

  .nav-toggle {
    display: none;
    background: rgba(12, 20, 36, 0.8);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0.55rem;
    color: var(--paper);
  }

  .nav-toggle__bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .nav-toggle__bars span {
    display: block;
    height: 2px;
    width: 100%;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .nav-toggle {
      display: block;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
      padding: var(--space-6);
      background: rgba(4, 7, 15, 0.98);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }

    .primary-nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .primary-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .primary-nav__list li + li {
      border-top: 1px solid var(--line);
    }

    .primary-nav__link {
      display: block;
      padding: var(--space-4) var(--space-2);
      font-size: 1.05rem;
    }

    .primary-nav__link::after {
      display: none;
    }

    .primary-nav__cta {
      margin-top: var(--space-4);
      width: 100%;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");
  const progress = document.getElementById("scroll-progress");

  function setOpen(open: boolean) {
    nav?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // Fecha ao navegar, ao carregar em Esc ou ao voltar ao desktop.
  nav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });

  window.matchMedia("(min-width: 821px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });

  // Estado "scrolled" + barra de progresso de leitura.
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      header?.classList.toggle("is-scrolled", y > 8);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (progress) progress.style.width = max > 0 ? `${Math.min(100, (y / max) * 100)}%` : "0%";
      ticking = false;
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
