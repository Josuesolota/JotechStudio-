---
import { STATS } from "../data/site";
---

<section class="stats" aria-label="Compromissos de trabalho">
  <div class="container">
    <ul class="stats__list">
      {
        STATS.map((s, i) => (
          <li class="stats__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="stats__value grad-text">{s.value}</span>
            <span class="stats__label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    padding-block: var(--space-8);
    border-block: 1px solid var(--line);
    background: rgba(12, 20, 36, 0.5);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .stats__label {
    font-size: 0.82rem;
    color: var(--paper-dim);
  }

  @media (max-width: 640px) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6) var(--space-4);
    }
  }
</style>
