---
/**
 * Substitui a lista suspensa nativa de um <select> por um menu construído
 * a nós, porque no Android/Chrome a lista nativa usa sempre o estilo do
 * sistema (fundo cinzento, círculos de rádio) e não pode ser estilizada
 * por CSS — é o próprio SO que a desenha.
 *
 * Mantém o <select> real no DOM (visualmente escondido só quando o JS
 * corre) para continuar a ser submetido normalmente com o formulário e
 * para funcionar sem JS como progressive enhancement.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  options: Option[];
}

const { id, name, options } = Astro.props;
const nativeId = `${id}-native`;
const listboxId = `${id}-listbox`;
---

<div class="custom-select" data-custom-select>
  <select id={nativeId} name={name} class="custom-select__native">
    {options.map((o) => <option value={o.value}>{o.label}</option>)}
  </select>

  <button
    type="button"
    id={id}
    class="custom-select__trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listboxId}
  >
    <span class="custom-select__value"></span>
    <svg class="custom-select__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
      <path
        d="M1 1.5L6 6.5L11 1.5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </button>

  <ul id={listboxId} class="custom-select__listbox" role="listbox" hidden>
    {
      options.map((o) => (
        <li role="option" tabindex="-1" data-value={o.value} class="custom-select__option">
          {o.label}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .custom-select {
    position: relative;
  }

  /* ── Estado sem JS: o <select> nativo fica visível e funcional ── */
  .custom-select__trigger,
  .custom-select__listbox {
    display: none;
  }

  html.js .custom-select__native {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  html.js .custom-select__trigger {
    display: flex;
  }

  /* ── Botão que substitui o <select> ─────────────────────────── */
  .custom-select__trigger {
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    background: linear-gradient(180deg, rgba(18, 27, 46, 0.7), rgba(4, 7, 15, 0.85));
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--paper);
    padding: 0.8rem 0.95rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .custom-select__trigger:hover {
    border-color: var(--line-strong);
  }

  .custom-select__trigger:focus-visible,
  .custom-select__trigger[aria-expanded="true"] {
    outline: none;
    border-color: var(--brand-blue-soft);
    box-shadow: 0 0 0 3px rgba(47, 111, 224, 0.18);
  }

  .custom-select__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-select__value.is-placeholder {
    color: var(--paper-faint);
  }

  .custom-select__chevron {
    flex-shrink: 0;
    color: var(--brand-blue-soft);
    transition: transform 0.18s ease;
  }

  .custom-select__trigger[aria-expanded="true"] .custom-select__chevron {
    transform: rotate(180deg);
  }

  /* ── Menu de opções ──────────────────────────────────────────── */
  html.js .custom-select__listbox.is-open {
    display: block;
  }

  .custom-select__listbox {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    max-height: 280px;
    overflow-y: auto;
    background: linear-gradient(180deg, rgba(20, 32, 54, 0.98), rgba(9, 15, 28, 0.98));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }

  .custom-select__option {
    padding: 0.65rem 0.8rem;
    border-radius: calc(var(--radius-sm) - 3px);
    color: var(--paper-dim);
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.14s ease, color 0.14s ease;
  }

  .custom-select__option.is-active {
    background: rgba(47, 111, 224, 0.16);
    color: var(--paper);
  }

  .custom-select__option.is-selected {
    color: var(--paper);
    font-weight: 600;
  }

  .custom-select__option.is-selected::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: var(--space-2);
    border-radius: 50%;
    background: var(--brand-blue-soft);
    vertical-align: middle;
  }
</style>

<script>
  function closeListbox(wrapper: Element) {
    const trigger = wrapper.querySelector<HTMLButtonElement>(".custom-select__trigger");
    const listbox = wrapper.querySelector<HTMLUListElement>(".custom-select__listbox");
    if (!trigger || !listbox) return;
    trigger.setAttribute("aria-expanded", "false");
    listbox.hidden = true;
    listbox.classList.remove("is-open");
  }

  function closeAllListboxes() {
    document.querySelectorAll("[data-custom-select]").forEach(closeListbox);
  }

  function syncTriggerLabel(wrapper: Element) {
    const select = wrapper.querySelector<HTMLSelectElement>(".custom-select__native");
    const valueEl = wrapper.querySelector<HTMLElement>(".custom-select__value");
    if (!select || !valueEl) return;
    const selected = select.options[select.selectedIndex];
    valueEl.textContent = selected?.textContent ?? "";
    valueEl.classList.toggle("is-placeholder", !selected?.value);

    wrapper.querySelectorAll<HTMLLIElement>(".custom-select__option").forEach((li) => {
      li.classList.toggle("is-selected", li.dataset.value === select.value);
    });
  }

  function selectOption(wrapper: Element, option: HTMLLIElement, focusTrigger = true) {
    const select = wrapper.querySelector<HTMLSelectElement>(".custom-select__native");
    const trigger = wrapper.querySelector<HTMLButtonElement>(".custom-select__trigger");
    if (!select) return;
    select.value = option.dataset.value ?? "";
    select.dispatchEvent(new Event("change", { bubbles: true }));
    syncTriggerLabel(wrapper);
    closeListbox(wrapper);
    if (focusTrigger) trigger?.focus();
  }

  function setActiveOption(wrapper: Element, option: HTMLLIElement | null) {
    wrapper.querySelectorAll<HTMLLIElement>(".custom-select__option").forEach((li) => {
      li.classList.toggle("is-active", li === option);
    });
    option?.focus();
  }

  function openListbox(wrapper: Element) {
    closeAllListboxes();
    const trigger = wrapper.querySelector<HTMLButtonElement>(".custom-select__trigger");
    const listbox = wrapper.querySelector<HTMLUListElement>(".custom-select__listbox");
    const select = wrapper.querySelector<HTMLSelectElement>(".custom-select__native");
    if (!trigger || !listbox || !select) return;
    trigger.setAttribute("aria-expanded", "true");
    listbox.hidden = false;
    listbox.classList.add("is-open");
    const current =
      wrapper.querySelector<HTMLLIElement>(`.custom-select__option[data-value="${select.value}"]`) ??
      wrapper.querySelector<HTMLLIElement>(".custom-select__option");
    setActiveOption(wrapper, current);
  }

  function initCustomSelect(wrapper: Element) {
    const trigger = wrapper.querySelector<HTMLButtonElement>(".custom-select__trigger");
    const listbox = wrapper.querySelector<HTMLUListElement>(".custom-select__listbox");
    const select = wrapper.querySelector<HTMLSelectElement>(".custom-select__native");
    const options = Array.from(wrapper.querySelectorAll<HTMLLIElement>(".custom-select__option"));
    if (!trigger || !listbox || !select) return;

    select.setAttribute("tabindex", "-1");
    select.setAttribute("aria-hidden", "true");
    syncTriggerLabel(wrapper);

    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) closeListbox(wrapper);
      else openListbox(wrapper);
    });

    trigger.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        openListbox(wrapper);
      }
    });

    options.forEach((option, i) => {
      option.addEventListener("click", () => selectOption(wrapper, option));

      option.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          selectOption(wrapper, option);
        } else if (e.key === "Escape") {
          e.preventDefault();
          closeListbox(wrapper);
          trigger.focus();
        } else if (e.key === "ArrowDown") {
          e.preventDefault();
          setActiveOption(wrapper, options[Math.min(i + 1, options.length - 1)]);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          setActiveOption(wrapper, options[Math.max(i - 1, 0)]);
        } else if (e.key === "Tab") {
          closeListbox(wrapper);
        }
      });
    });
  }

  document.querySelectorAll("[data-custom-select]").forEach(initCustomSelect);

  document.addEventListener("click", (e) => {
    document.querySelectorAll("[data-custom-select]").forEach((wrapper) => {
      if (!wrapper.contains(e.target as Node)) closeListbox(wrapper);
    });
  });
</script>
