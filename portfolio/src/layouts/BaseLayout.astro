---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PWAInstall from "../components/PWAInstall.astro";
import { CONTACT, SITE } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Define o título exatamente como passado, sem sufixo da marca */
  rawTitle?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-image.jpg",
  rawTitle = false,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const pageTitle = rawTitle ? title : `${title} · ${SITE.name}`;

// Dados estruturados: ajuda o Google a mostrar a marca corretamente
// e permite rich results para o negócio de serviços digitais.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE.url}/#business`,
      name: SITE.name,
      description: SITE.shortDescription,
      url: SITE.url,
      image: `${SITE.url}/og-image.jpg`,
      logo: `${SITE.url}/icons/icon-512.png`,
      email: CONTACT.email,
      priceRange: "$$",
      areaServed: "Worldwide",
      availableLanguage: ["pt", "en"],
      founder: { "@id": `${SITE.url}/#person` },
      sameAs: [CONTACT.github, CONTACT.linkedin],
      knowsAbout: [
        "Desenvolvimento Web",
        "Landing Pages",
        "E-commerce",
        "Trading Algorítmico",
        "Deriv API",
        "Automação de Processos",
      ],
    },
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.founder,
      jobTitle: SITE.role,
      url: SITE.url,
      email: CONTACT.email,
      sameAs: [CONTACT.github, CONTACT.linkedin],
      worksFor: { "@id": `${SITE.url}/#business` },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: "pt-PT",
      publisher: { "@id": `${SITE.url}/#business` },
    },
  ],
};
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.founder} />
    <meta name="generator" content={Astro.generator} />

    <!-- Ícones -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#2f6fe0" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#04070f" />
    <meta name="color-scheme" content="dark" />
    <!-- Nome curto para caber sob o ícone (ver comentário em src/data/site.ts) -->
    <meta name="application-name" content={SITE.pwaShortName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={SITE.pwaShortName} />
    <meta name="msapplication-TileColor" content="#04070f" />
    <meta name="msapplication-TileImage" content="/icons/icon-144.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- Marca a página como "com JS" o mais cedo possível, para as
         animações de entrada não deixarem conteúdo invisível se o JS falhar. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Saltar para o conteúdo</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PWAInstall />

    <script>
      // Animação de entrada por IntersectionObserver — barata e
      // desligada automaticamente com prefers-reduced-motion (CSS).
      const els = document.querySelectorAll("[data-reveal]");

      if (!("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
